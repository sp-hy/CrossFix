@echo off
rem Compiles the PGXP polygon shaders into pgxp_shaders.h (needs fxc from the
rem Windows SDK on the PATH or in FXC).
setlocal
cd /d "%~dp0"
if not defined FXC set "FXC=fxc"
set "FLAGS=/nologo /O3 /E main"
"%FXC%" %FLAGS% /T vs_4_0 /Vn g_pgxpPolyVs /Fh vs.tmp pgxp_poly_vs.hlsl || exit /b 1
"%FXC%" %FLAGS% /T ps_4_0 /Vn g_pgxpPolyPs /Fh ps.tmp pgxp_poly_ps.hlsl || exit /b 1
"%FXC%" %FLAGS% /T ps_4_0 /D ROUND_ALPHA=1 /Vn g_pgxpPolyPsRoundAlpha /Fh psr.tmp pgxp_poly_ps.hlsl || exit /b 1
echo // Generated by build_shaders.bat from pgxp_poly_vs.hlsl and pgxp_poly_ps.hlsl.> pgxp_shaders.h
echo #pragma once>> pgxp_shaders.h
copy /b pgxp_shaders.h + vs.tmp + ps.tmp + psr.tmp pgxp_shaders.h >nul
del vs.tmp ps.tmp psr.tmp
endlocal
